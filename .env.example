# SkillSwap Backend Environment Variables (Render)
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# Supabase PostgreSQL Database Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# SkillSwap Frontend Environment Variables (Cloudflare Pages)
VITE_API_BASE_URL=https://skillswap-api.onrender.com/api
